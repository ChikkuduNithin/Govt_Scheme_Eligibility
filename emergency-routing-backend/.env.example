MONGO_URI=mongodb://localhost:27017
DB_NAME=emergency_routing
PORT=8000
AVG_URBAN_SPEED_KMH=30.0

# ETA routing: "haversine" (built-in estimate) or "openrouteservice" (real road routing)
ROUTING_PROVIDER=haversine
ROUTING_API_KEY=

# Alerts auto-reject + re-route if the hospital does not respond in time
ALERT_RESPONSE_TIMEOUT_SECONDS=30

# Hospital status is treated as stale (not eligible) after this many seconds
MAX_STATUS_AGE_SECONDS=600

# WebSocket keepalive ping interval
WS_KEEPALIVE_SECONDS=30